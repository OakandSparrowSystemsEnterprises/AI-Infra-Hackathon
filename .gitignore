# --- Always keep what judges need --------------------------------------------
# Example configuration is always tracked, whatever its extension.
!*.example.*
# Test fixtures may legitimately contain small dataset, model, capture, or
# receipt samples. Re-include only those data types under tests/fixtures so
# the rules above never hide committed fixtures. Everything else (bytecode,
# caches, editor and OS metadata, environment files, credentials, keys) stays
# ignored under fixtures too, because only these patterns are re-included.
!**/tests/fixtures/**/models/
!**/tests/fixtures/**/weights/
!**/tests/fixtures/**/checkpoints/
!**/tests/fixtures/**/*.npy
!**/tests/fixtures/**/*.npz
!**/tests/fixtures/**/*.h5
!**/tests/fixtures/**/*.hdf5
!**/tests/fixtures/**/*.parquet
!**/tests/fixtures/**/*.tfrecord
!**/tests/fixtures/**/*.onnx
!**/tests/fixtures/**/*.pt
!**/tests/fixtures/**/*.pth
!**/tests/fixtures/**/*.ckpt
!**/tests/fixtures/**/*.safetensors
!**/tests/fixtures/**/*.tflite
!**/tests/fixtures/**/*.engine
!**/tests/fixtures/**/*.gguf
!**/tests/fixtures/**/*.bin
!**/tests/fixtures/**/*.xml
!**/tests/fixtures/**/*.blob
!**/tests/fixtures/**/*.capture.*
!**/tests/fixtures/**/*.receipt.json
!**/tests/fixtures/**/*.receipts.json
!**/tests/fixtures/**/*.receipt-chain.json
!**/tests/fixtures/**/receipt_chain*.json
!**/tests/fixtures/**/*.demo.json
!**/tests/fixtures/**/metrics_snapshot*.json
