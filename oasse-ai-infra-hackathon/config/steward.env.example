# Greenfield Steward is opt-in. Default project runtime remains unchanged.
STEWARD_MODE=observe
# Optional. Leave blank to use required-agent count, minimum 1.
STEWARD_MIN_SUCCESSES=

# Tenki can be one Steward-managed agent.
TENKI_MODE=observe
TENKI_DERIVE_URL=https://REPLACE_WITH_LIVE_TENKI_PREVIEW/derive
TENKI_TIMEOUT_S=0.20
TENKI_DERIVE_TOKEN=

# Local loopback testing only.
TENKI_ALLOW_LOOPBACK_HTTP=0
