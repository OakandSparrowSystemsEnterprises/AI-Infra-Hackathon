# Copy to an untracked local environment file. Never commit real credentials.
AUTHORITY_MODE=live
GATEKEEPER_URL=https://REPLACE_WITH_DEPLOYED_GATEKEEPER_HOST
GATEKEEPER_TOKEN=REPLACE_LOCALLY_ONLY

# Tenki is initially OFF for hardware bring-up. After the non-actuating /derive
# probe passes, use observe; promote to required only when the live latency is
# stable inside the evidence freshness budget.
TENKI_MODE=off
TENKI_DERIVE_URL=https://REPLACE_WITH_LIVE_TENKI_WORKER/derive
TENKI_DERIVE_TOKEN=
TENKI_TIMEOUT_S=0.20

# Reference limits retained for local/reference fallback rehearsals only.
EVIDENCE_MAX_AGE_MS=500
MIN_CONFIDENCE=0.80
MAX_SPEED_MPS=0.35

# Event-specific inputs are intentionally not guessed here.
# CAMERA_INDEX=0
# OPENVINO_DEVICE=CPU
# DETECTOR_MODEL_PATH=/absolute/path/to/exported/model
# VLA_MODEL_PATH=/absolute/path/to/model-or-checkpoint
# ROBOT_PROFILE=event-provided-profile
