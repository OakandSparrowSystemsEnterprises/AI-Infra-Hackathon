# Default local mode uses the MIT-licensed reference authority engine.
AUTHORITY_MODE=reference

# Required only when AUTHORITY_MODE=live. Production authority must use HTTPS.
GATEKEEPER_URL=
GATEKEEPER_TOKEN=
# Fail fast by default; evidence is only fresh for the declared dispatch window.
GATEKEEPER_TIMEOUT_S=0.25

# Optional Tenki pre-authority evidence plane. OFF preserves the original path.
# observe = attach valid Tenki evidence when available, but do not require it.
# required = HOLD before Gatekeeper if the Tenki /derive contract does not pass.
TENKI_MODE=off
TENKI_DERIVE_URL=
TENKI_DERIVE_TOKEN=
TENKI_TIMEOUT_S=0.20
# Local-only testing escape hatch. Do not enable for exposed/production endpoints.
TENKI_ALLOW_LOOPBACK_HTTP=0

# Reference-engine demo thresholds and local dispatch freshness window.
EVIDENCE_MAX_AGE_MS=500
MIN_CONFIDENCE=0.80
MAX_SPEED_MPS=0.35
