# BAND Remote Agent credentials. Each API key is displayed once when the agent is created.
PLANNER_AGENT_ID=
PLANNER_API_KEY=
BUILDER_AGENT_ID=
BUILDER_API_KEY=
REVIEWER_AGENT_ID=
REVIEWER_API_KEY=

# Repository or directory the coding factory works against.
# Leave blank to use wearedevelopers-dark-factory itself.
FACTORY_WORKSPACE=

# Leave blank for explicitly labeled local reference authority.
# Set these when the live OASSE Gatekeeper endpoint is ready.
GATEKEEPER_URL=
GATEKEEPER_PATH=/v1/evaluate
GATEKEEPER_TOKEN=
GATEKEEPER_TIMEOUT_MS=2000
