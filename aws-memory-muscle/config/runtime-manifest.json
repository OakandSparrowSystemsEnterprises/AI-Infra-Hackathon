{
  "project": "oasse-memory-muscle",
  "authority": {
    "provider": "gatekeeper-v2-external",
    "authoritative": true,
    "journal_semantics": "single-writer",
    "allowed_verdicts": ["ALLOW", "TRANSFORM", "HOLD", "DENY"]
  },
  "planes": {
    "rocketride": {"role": "control-plane", "required": true, "authoritative": false, "integration": "native-pipeline"},
    "cognee": {"role": "semantic-memory", "required": true, "authoritative": false, "integration": "rocketride-native"},
    "hydradb": {"role": "durable-graph", "required": true, "authoritative": false, "integration": "rocketride-native"},
    "hotdata": {"role": "live-state-and-analytics", "required": true, "authoritative": false, "integration": "rocketride-native"},
    "rote": {"role": "procedure-memory", "required": true, "authoritative": false, "integration": "event-created"},
    "snyk": {"role": "security-evidence", "required": true, "authoritative": false, "integration": "sandbox-cli-or-agent-tool"},
    "tenki": {"role": "isolated-compute", "required": false, "authoritative": false, "integration": "rocketride-mcp"},
    "github_effect": {"role": "controlled-effect", "required": true, "authoritative": false, "integration": "behind-gatekeeper-only"}
  },
  "constraints": {
    "tenki_has_unrestricted_github_write_credential": false,
    "sponsor_state_may_write_gatekeeper_journal": false,
    "prior_authorization_may_be_reused": false,
    "rote_replay_requires_fresh_authorization": true,
    "support_plane_failure_implies_allow": false
  }
}
