{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oasse.example/schemas/action-envelope.schema.json",
  "title": "ActionEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["action_type", "target", "repository", "base_sha", "patch_sha256", "actor_id", "evidence"],
  "properties": {
    "action_type": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "minLength": 7},
    "patch_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "actor_id": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "ref", "sha256"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    }
  }
}
